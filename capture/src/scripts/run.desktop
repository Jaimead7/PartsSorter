# Copy this file into /home/<user>/.config/autostart/ to start the chromium browser with the web interface.
# Change the url of the web if it is not allocated on the same device.


[Desktop Entry]
Version=1.0
Type=Application
Name=Capture
Exec=chromium-browser --kiosk --no-firs-run "localhost:5000/image-stream"
Icon=chromium
Terminal=false
StartupNotify=false
X-GNOME-Autostart-Delay=0