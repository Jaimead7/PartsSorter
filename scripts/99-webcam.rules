# Copy this file into /etc/udev/rules.d/99-webcam.rules
# Get the attrs of the camera with (change /etc/video0 to match actual camera): udevadm info -a -n /dev/video0
# Use some unique attrs from the output of this command. Use attrs for the same parent.

SUBSYSTEM=="video4linux", ATTRS{name}=="C270 HD WEBCAM", ATTRS{index}=="0", SYMLINK+="main-camera"